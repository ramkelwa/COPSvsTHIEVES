# The game works with OpenStreetMap out of the box — no key required.
# To use a Mapbox/Google raster tile endpoint, set both values below.
#
# Mapbox example:
# VITE_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/512/{z}/{x}/{y}@2x?access_token=YOUR_TOKEN
# VITE_MAP_ATTRIBUTION=© Mapbox © OpenStreetMap
#
# Optional: point the client at a different API origin when not using the Vite proxy.
# (By default Vite proxies /api and /socket.io to http://localhost:4000.)
