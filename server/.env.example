# Copy to server/.env and adjust for your machine/deployment.

# HTTP + Socket.IO port
PORT=4000

# REQUIRED in production: a long random string. Sessions are invalidated when it changes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed browser origins in development.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# Where the JSON store (accounts, history, results) is written.
# Defaults to server/data next to the compiled source.
# DATA_DIR=./data
