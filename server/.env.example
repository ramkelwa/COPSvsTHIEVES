# Copy to server/.env and adjust for your machine/deployment.

# HTTP + Socket.IO port
PORT=4000

# REQUIRED in production: a long random string. Sessions are invalidated when it changes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed browser origins in development.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# Optional for local development; required in production. PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/cops_vs_thieves
# Set true only when your provider requires SSL on the database connection.
# DATABASE_SSL=false

# Used only when DATABASE_URL is not set (local development).
# DATA_DIR=./data
